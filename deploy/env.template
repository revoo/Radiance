# Copy to /opt/hosting/radiance/.env and fill in. Never commit it. chmod 600.
#
# Set the password with ./set-password.sh, which fills in the hash below. If you edit it by hand: Compose
# expands $ in this file, so keep the hash in SINGLE quotes, or it silently becomes garbage.
RADIANCE_USERNAME=
RADIANCE_PASSWORD_BCRYPT=''

# LLM providers: one key per provider you use. Routes without a keyed model fall back to placeholder prose.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Backups to Cloudflare R2 (docs/ops/hosting.md). Until these are set, backups stay on this server and
# the app warns loudly: in the log, and in a banner in the app.
CF_ACCOUNT_ID=
# Generated photos and avatars (Workers AI). Without it they're placeholders, and residents keep their initials.
CF_AI_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
