# Copy to /opt/hosting/radiance/.env and fill in. Never commit it. chmod 600.
#
# Compose expands $ in this file: keep the bcrypt hash in SINGLE quotes, or it silently becomes garbage.
# Make the hash with:  docker run --rm httpd:2-alpine htpasswd -bnBC 12 "" 'your password' | tr -d ':\n'
RADIANCE_USERNAME=
RADIANCE_PASSWORD_BCRYPT=''

# LLM providers: one key per provider you use. Routes without a keyed model fall back to placeholder prose.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Backups to Cloudflare R2 (docs/ops/hosting.md). Until these are set, backups stay on this server and
# the app warns loudly: in the log, and in a banner in the app.
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
