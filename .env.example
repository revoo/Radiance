# Copy to .env and fill in what you use. Never commit .env. (SPEC §5.17)
# The app reads it automatically (spring.config.import); plain environment variables work too.
# The offline profile needs none of these.

# Single local user. Generate the hash with any bcrypt tool (cost 10–12).
RADIANCE_USERNAME=
RADIANCE_PASSWORD_BCRYPT=

# LLM providers: one key per provider in radiance.llm.providers. Routes whose models
# have no key fall back to FakeLlm in the local profile.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cloudflare: Workers AI (image generation and the workers-ai LLM provider)
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=

# Cloudflare R2: nightly backups (ADR 0019) and, later, media. Needs CF_ACCOUNT_ID above, or a full
# R2_ENDPOINT for any other S3-compatible store. Without these, backups stay on the server and the app
# says so loudly.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
R2_BUCKET=

# Bearer token for POST /internal/batch/nightly
BATCH_TRIGGER_TOKEN=
